DATABASE_URL=postgresql://gold:gold@localhost:5432/gold
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
PRICE_SOURCE=sample
ENABLE_SCHEDULER=false
UPDATE_INTERVAL_MIN=15
# Markets refreshed at once on each update, and feed downloads at once (the free feed throttles).
FEED_CONCURRENCY=2
UPDATE_WORKERS=3
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
NEWS_MODEL=claude-opus-5-5
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=20
LIVE_PRICES=true
MINUTE_DAYS=60
SECOND_DAYS=2
# Account emails and Google sign-in
APP_URL=http://localhost:3000
# resend | smtp | console (console prints emails to the API log; the default when RESEND_API_KEY is empty)
EMAIL_PROVIDER=console
EMAIL_FROM=Trading Lab <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Markets fetched on every update (the rest load the first time someone opens them), how long a market
# stays in use after it was last opened, and how many live symbols Finnhub streams at once.
